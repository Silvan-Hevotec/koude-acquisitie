{
  "name": "Leadnex",
  "short_name": "Leadnex",
  "description": "Bedrijven, acties en contactmomenten voor acquisitie.",
  "lang": "nl",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0C2925",
  "theme_color": "#0C2925",
  "icons": [
    {
      "src": "icons/leadnex-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/leadnex-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/leadnex-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "deel_titel",
      "text": "deel_tekst",
      "url": "deel_url"
    }
  },
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "shortcuts": [
    {
      "name": "Nieuwe afspraak",
      "short_name": "Afspraak",
      "url": "./?snel=afspraak",
      "icons": [
        {
          "src": "icons/snel-afspraak.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Nieuwe notitie",
      "short_name": "Notitie",
      "url": "./?snel=notitie",
      "icons": [
        {
          "src": "icons/snel-notitie.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Belsessie starten",
      "short_name": "Belsessie",
      "url": "./?snel=belsessie",
      "icons": [
        {
          "src": "icons/snel-belsessie.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Nieuw bedrijf",
      "short_name": "Bedrijf",
      "url": "./?snel=bedrijf",
      "icons": [
        {
          "src": "icons/snel-bedrijf.png",
